.main-container {
    padding: 12px;
    flex-direction: column;
    height: 100%;
}

/* 替代 gap：给每个子区块加下边距 */
.main-container > .section,
.main-container > .button-row {
    margin-bottom: 12px;
}

/* UI Toolkit 不支持 :last-child 伪类；最后一个区块（日志区）直接清零下边距 */
.main-container > .log-section {
    margin-bottom: 0;
}

.section {
    flex-direction: column;
}

.section-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: #c0c0c0;
    margin-bottom: 8px;
}

.form-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.form-label {
    width: 70px;
    font-size: 12px;
    color: #a0a0a0;
    margin-right: 8px; /* 替代 gap */
    flex-shrink: 0;
}

.form-control {
    flex: 1;
    height: 24px;
}

/* 生成状态行（颜色由 C# 按状态机状态覆盖） */
.status-label {
    flex: 1;
    font-size: 13px;
    color: #a0a0a0;
}

.input-area {
    height: 100px;
    flex-shrink: 0;
}

.button-row {
    flex-direction: row;
    height: 32px;
}

.primary-button {
    flex: 2;
    background-color: #2d6cdf;
    color: white;
    -unity-font-style: bold;
    margin-right: 8px; /* 替代 gap */
}

.primary-button:hover {
    background-color: #3a7bef;
}

.secondary-button {
    flex: 1;
    background-color: #3a3a3a;
    color: #e0e0e0;
}

/* 取消生成按钮（生成中才显示，红色警示） */
.cancel-button {
    flex: 1;
    background-color: #b04a4a;
    color: white;
    margin-right: 8px; /* 替代 gap */
}

.cancel-button:hover {
    background-color: #c05a5a;
}

/* 构建进度条（生成/构建中显示） */
.progress-bar {
    margin-bottom: 12px;
}

.log-section {
    flex: 1;
    min-height: 150px;
    flex-direction: column;
}

/* 第四周-Day5：日志级别筛选行（信息/警告/错误/成功） */
.log-filter-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.filter-toggle {
    margin-right: 12px;
    font-size: 12px;
    color: #a0a0a0;
}

/* 第四周-Day5：生成报告区（任务终态时显示，折叠在日志下方，不挤压日志主区） */
.report-section {
    flex-shrink: 0;
    max-height: 200px;
    margin-top: 12px;
}

.log-scroll {
    flex: 1;
    background-color: #1e1e1e;
    border-width: 1px;
    border-color: #333333;
    padding: 8px;
}

.log-content {
    font-size: 12px;
    color: #d4d4d4;
    white-space: pre-wrap;
}
